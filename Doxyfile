# Doxyfile for Botanik - greenhouse control system (libbotanik)
#
# Generate docs with:    doxygen Doxyfile
# Output lands in:       docs/doxygen/html/index.html
#
# Tuned for Doxygen 1.9.x. The source uses JavaDoc-style comments, so this
# config points Doxygen at src/ and turns on full extraction.

#---------------------------------------------------------------------------
# Project identity
#---------------------------------------------------------------------------
PROJECT_NAME           = "Botanik"
PROJECT_NUMBER         = 0.13.12-dev
PROJECT_BRIEF          = "Greenhouse control system for the Arduino OPTA PLC"
PROJECT_LOGO           = images/logo-small.png
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
# docs/index.md is the mainpage, named by USE_MDFILE_AS_MAINPAGE below.
# README.md is the GitHub front page and stays out of the API docs.
INPUT                  = src \
                         tests \
                         docs
FILE_PATTERNS          = *.h *.cpp *.c *.md
USE_MDFILE_AS_MAINPAGE = docs/index.md
RECURSIVE              = YES
# A diagram lives with the page that references it, in the section's own
# diagrams/ where a section has several, so this lists the doc directories that
# hold one. images/ keeps the logos, and images/logic/ the block drawings no
# page references yet.
IMAGE_PATH             = images \
                         images/logic \
                         docs/gh_mlb41/diagrams \
                         docs/integration/diagrams \
                         docs/dev/foundations \
                         docs/dev/runtime \
                         docs/dev/console \
                         docs/dev/field

# Where \verbinclude looks. The console screenshots in the user manual are
# captured by scripts/screens.py and kept beside the pages that show them,
# so the generator only ever writes .txt and never touches a page's prose.
EXAMPLE_PATH           = docs/user/screens \
                         docs/gh_mlb41/screens

# Working notes, if any: excluded so a plan never renders beside the manual.
EXCLUDE                = docs/design

# Vendored toolchain and Mbed headers, and build artifacts. The doctest single
# header under tests/vendor is third-party too.
EXCLUDE_PATTERNS       = */build/* \
                         */includes/* \
                         */archive/* \
                         */CMakeFiles/* \
                         */tests/vendor/* \
                         */.pytest_cache/* \
                         */__pycache__/* \
                         */sites/*/README.md

# Implementation-detail namespaces are not API. Anonymous ones go through
# EXTRACT_ANON_NSPACES below; named `detail` ones are excluded by symbol.
EXCLUDE_SYMBOLS        = *::detail \
                         *::detail::*

#---------------------------------------------------------------------------
# What to extract
#---------------------------------------------------------------------------
# Many .cpp files carry no doc comments; EXTRACT_ALL documents their
# declarations anyway, so the API surface is complete.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = NO

# The source explicitly writes @brief everywhere, so leave autobrief off.
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO

# It's C++ with STL usage (std::chrono, std::string, ...).
OPTIMIZE_OUTPUT_FOR_C  = NO
BUILTIN_STL_SUPPORT    = YES

#---------------------------------------------------------------------------
# Source browsing & layout
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
ALPHABETICAL_INDEX     = YES
SORT_MEMBER_DOCS       = NO
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = src
TAB_SIZE               = 4

#---------------------------------------------------------------------------
# Preprocessing
#---------------------------------------------------------------------------
# Parse #include directives, but leave TARGET_SIMULATOR and TARGET_OPTA
# undefined so Doxygen documents both HAL backends (hal/simulator.h and
# hal/opta.h) rather than one platform's branch.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = src

#---------------------------------------------------------------------------
# Diagrams (graphviz is available)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_MULTI_TARGETS      = YES

# PlantUML (\startuml blocks). Not vendored: point this at the system jar
# (Debian/Ubuntu: `apt install plantuml`).
PLANTUML_JAR_PATH      = /usr/share/plantuml/plantuml.jar

#---------------------------------------------------------------------------
# Output formats
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Warnings / diagnostics
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = docs/doxygen/doxygen-warnings.log

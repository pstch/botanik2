{# <name>.h - one enumeration the LIBRARY owns, C++ side.

   context
     banner   the "GENERATED by" line
     guard    the include guard
     file     where this file sits, for the @file line
     ns       the namespace inside Botanik
     type     the C++ type name
     scoped   true for `enum class`
     ctype    the underlying type
     lower    the prefix for the label helpers
     members  one per code: { symbol, value, label, desc }
     doc      the type's own brief, as lines
     st       the ST type name, which matiec numbers in this order
#}
{{ banner }}
#ifndef {{ guard }}
#define {{ guard }}

/**
 * @file {{ file }}
{% for l in doc %}
 * {{ l }}
{% endfor %}
 *
 * Generated from vars/tables/library_enums.csv, which is also where
 * plc/runtime/{{ lower }}.gen.h gets the constants matiec is handed. matiec
 * numbers an ST enumeration 0,1,2... in declaration order, so the ORDER here is
 * the wire contract with `{{ st }}`: a code may be appended, never moved.
 */

#include <cstdint>

namespace Botanik { namespace {{ ns }} {

    enum {{ 'class ' if scoped }}{{ type }} : {{ ctype }} {
{% set w = members | width('symbol') %}
{% for e in members %}
        {{ e.symbol | pad(w) }} = {{ e.value }},{{ e.desc | suffix('   ///< %s') }}
{% endfor %}
    };

    /** @brief A {{ type }} code as the word an operator reads and types.
     *  @note Null for anything that is not one, which is what a T_ENUM row
     *  refuses. @see {{ lower }}_name() for the typed form. */
    inline const char* {{ lower }}_label(uint64_t code) {
        switch (code) {
{% for e in members %}
            case (uint64_t){{ type }}{{ '::' if scoped else '::' }}{{ e.symbol }}: return "{{ e.label }}";
{% endfor %}
            default: return nullptr;
        }
    }

    /** @brief @p v as a word. The typed form of {{ lower }}_label(), so the two
     *  vocabularies cannot drift. */
    inline const char* {{ lower }}_name({{ type }} v) {
        const char* n = {{ lower }}_label((uint64_t)v);
        return (n != nullptr) ? n : "?";
    }

}}  // namespace Botanik::{{ ns }}

#endif // {{ guard }}

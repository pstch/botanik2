{# config.gen.h - the site's build-wide defines and feature opt-ins.

   context
     guard         the site's include-guard prefix
     values        (name, value) pairs, each defined under an #ifndef
     features      one per flag the site turns on:
                   { name, needs } - `needs` are its prerequisites, each
                   nesting the #ifndef one level further in
     features_off  one name per flag the site turns off
#}
// GENERATED by scripts/tables.py from site.toml. Do not edit.

#ifndef {{ guard }}_CONFIG_GEN_H
#define {{ guard }}_CONFIG_GEN_H

{% for k, v in values %}
#ifndef BOTANIK_{{ k }}
#  define BOTANIK_{{ k }} {{ v }}
#endif
{% endfor %}

// Every flag this site turns on, each under the prerequisites the LIBRARY
// declares. The guard is "unless explicitly turned off", so precedence
// stays command line > site > header default.
{% for f in features %}
{% set indent = '  ' * (f.needs | length) %}
{% for d in f.needs %}
{{ '  ' * loop.index0 }}#if !defined(BOTANIK_FEATURE_{{ d }}) || BOTANIK_FEATURE_{{ d }}
{% endfor %}
{{ indent }}#ifndef BOTANIK_FEATURE_{{ f.name }}
{{ indent }}#  define BOTANIK_FEATURE_{{ f.name }} 1
{{ indent }}#endif
{% for d in f.needs %}
{{ '  ' * (f.needs | length - loop.index) }}#endif
{% endfor %}
{% endfor %}
{% if features_off %}

// ...and every flag it turns off. No prerequisites to nest: taking a feature
// out cannot violate one, and a dependent left on is the #error's business.
{% for f in features_off %}
#ifndef BOTANIK_FEATURE_{{ f }}
#  define BOTANIK_FEATURE_{{ f }} 0
#endif
{% endfor %}
{% endif %}

// This site's table is CUT for the profile above: a guarded library row the
// build leaves out shifts every index after it, and the indices are generated
// constants. So refuse rather than drift. Here rather than in a header the
// site hand-writes, because the flags have their defaults by the time this is
// read again.
#define BOTANIK_SITE_ASSERT_FEATURES \
{% for f in features %}
    BOTANIK_FEATURE_{{ f.name }} && \
{% endfor %}
    1


#endif

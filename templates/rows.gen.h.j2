{# rows.gen.h - one index per row, library and site.

   context
     banner   the "GENERATED by" line
     guard    the site's include-guard prefix
     rows     one per row, in table order: { name, index }
     abi      BOTANIK_CODEGEN_ABI, out of libbotanik/codegen_abi.h
#}
{% set w = rows | width('name') %}
{{ banner }}

/**
 * @file rows.gen.h
 * @brief One index per row, library and site, in ONE namespace.
 *
 * What everything but the console addresses a row through. A name no
 * table declares is a COMPILE error here, rather than a reference that
 * resolves to the sink for the life of the run.
 */

#ifndef {{ guard }}_ROWS_GEN_H
#define {{ guard }}_ROWS_GEN_H

#include <cstdint>

/// What vars/rows.h checks against the library's BOTANIK_CODEGEN_ABI.
#define BOTANIK_SITE_CODEGEN_ABI {{ abi }}

namespace Botanik { namespace Vars { namespace Row {

{% for r in rows %}
    const uint16_t {{ r.name | pad(w) }} = {{ r.index }};
{% endfor %}

}}}  // namespace Botanik::Vars::Row

#endif  // {{ guard }}_ROWS_GEN_H

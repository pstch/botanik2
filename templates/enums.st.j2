{# enums.st - the same codes, ST side. Compiled ahead of the laws.

   context
     banner   the "GENERATED by" line, as an ST comment
     groups   one per enumeration: { name, members }
              a member is { symbol, desc }
#}
{{ banner }}

(* The site's enumerated codes, so a law compares against the WORD.
   matiec numbers these in declaration order and the C++ side is the
   SAME type, so the order IS the wire contract: a member may be
   appended, never moved. *)

TYPE

{% for g in groups %}
{% set w = g.members | width('symbol') %}
  {{ g.name }} : (
{% for e in g.members %}
    {{ e.symbol | pad(w) }}{{ "," if not loop.last }}{{ e.desc | suffix('   (* %s *)') }}
{% endfor %}
  );

{% endfor %}
END_TYPE

/*
 * entry.cpp - the integrator's project-root entry point.
 *
 * Copy this next to your .ino (at the SKETCH ROOT, not inside src/) and adapt
 * the site path if your site is named differently. This file is deliberately
 * outside the vendored src/ tree so `make vendor` can never overwrite it.
 *
 * Why it lives at the root: the IDE compiles the sketch root and src/**
 * recursively, and a quoted include resolves against the including file's own
 * directory. This file sits at the root, so "src/..." resolves from here - which
 * is the one place that path works.
 *
 * The sketch window itself stays trivial:
 *
 *     extern "C" void botanik_setup(void);
 *     extern "C" void botanik_step(void);
 *     void setup() { botanik_setup(); }
 *     void loop()  { botanik_step(); }
 *
 * Adjust the hook names to whatever the Axel runtime actually calls.
 */

#include "src/sites/gh_mlb41/site.h"   // BotanikSite + the PLC payload

/*
 * A function-local static, so the firmware is constructed on first call rather
 * than before main(): the Arduino core's init() must have brought up the UARTs
 * and the PLC shared-memory region before we bind to them. No heap.
 */
static BotanikSite& firmware() {
    static BotanikSite fw;   // default ctor binds the coprocessor region via HAL
    return fw;
}

/*
 * Payload contract. Once the PLC IDE's generated types are in scope here, assert
 * that our payload matches them byte for byte - this is the one check that
 * catches a regenerated PLC program drifting from the regenerated site:
 *
 *   static_assert(sizeof(PLCSharedVarsInput_t)   == sizeof(Botanik::PlcIO::PlcInput<PlcInputData_t>), "");
 *   static_assert(sizeof(PLCSharedVarsOutput_t)  == sizeof(Botanik::PlcIO::PlcOutput<PlcOutputData_t>), "");
 *   static_assert(alignof(PLCSharedVarsOutput_t) == alignof(Botanik::PlcIO::PlcOutput<PlcOutputData_t>), "");
 */

extern "C" void botanik_setup(void) {
    firmware().setup();   // UARTs, log sinks, pages, banner, POST, watchdog
}

extern "C" void botanik_step(void) {
    firmware().loop();    // one gated main-loop iteration
}

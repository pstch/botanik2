# Parallel make by default (run `direnv allow` once to load this).
# MAKEFLAGS is read by make itself, so a bare `make -C build` builds with -j4.
export MAKEFLAGS="-j4"

# Parallel ctest by default. CTEST_PARALLEL_LEVEL is read by ctest itself, so a
# bare `ctest --test-dir build` runs cases concurrently. Bounded to the core
# count so each timing-sensitive pyte sim keeps a core; they drop input if
# oversubscribed. The `make check` gate passes the same -j explicitly.
export CTEST_PARALLEL_LEVEL="${CTEST_PARALLEL_LEVEL:-$(nproc)}"

# ccache big enough to hold this tree's objects. -g3 -gdwarf-4 objects run
# ~578 KiB each, a configured tree is ~74 MB of them, and we keep several at once
# (build/, build-opta/, build/asan/). The stock 5G evicted faster than it filled.
# Read by ccache itself, so it applies to every build in this tree.
export CCACHE_MAXSIZE="${CCACHE_MAXSIZE:-25G}"

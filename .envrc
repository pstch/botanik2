# Parallel make by default (run `direnv allow` once to load this).
# MAKEFLAGS is read by make itself, so a bare `make -C build` builds with -j4.
export MAKEFLAGS="-j4"

# Parallel ctest by default. CTEST_PARALLEL_LEVEL is read by ctest itself, so a
# bare `ctest --test-dir build` runs cases concurrently (the doctest cases and the
# per-test pyte entries are independent). Bounded to the core count so the timing-
# sensitive pyte sims each keep a core (they drop input if oversubscribed); the
# `make check` gate passes the same -j explicitly (see tests/CMakeLists.txt).
export CTEST_PARALLEL_LEVEL="${CTEST_PARALLEL_LEVEL:-$(nproc)}"

# ccache big enough to actually hold this tree's objects. ccache's stock 5G was
# running at a 31% hit rate here, 99.94% full with 160 cleanups: -g3 -gdwarf-4
# objects are ~578 KiB each, a configured tree is ~74 MB of them, and this project
# keeps several at once (build/, build/pyte-sim/, build/asan/) on top of whatever
# else shares the cache. It was evicting faster than it filled, which is why the
# "clean rebuild replays in a couple of seconds" claim did not hold in practice.
# Read by ccache itself, so it applies to every build in this tree.
export CCACHE_MAXSIZE="${CCACHE_MAXSIZE:-25G}"

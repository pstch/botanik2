{
    "version": "2.0.0",
    "tasks": [
        {
            // Make sure build-debug/ exists and is configured for the SIMULATOR
            // target — a DEBUG build with ASan+UBSan and the doctest suite wired in.
            // Safe to re-run: cmake no-ops if the cache is already up to date.
            "label": "cmake-configure-sim",
            "type": "shell",
            "command": "cmake -B build-debug -DBOTANIK_TARGET=SIMULATOR",
            "problemMatcher": []
        },
        {
            // Build just the simulator binary (build-debug/botanik_sim).
            "label": "build-sim",
            "type": "shell",
            "command": "make -C build-debug botanik_sim",
            "dependsOn": "cmake-configure-sim",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            // Build + run the doctest suite via CTest. --output-on-failure echoes
            // a failing case's assertions inline. This builds botanik_tests first
            // (ctest itself does not), so it's safe to run from a clean tree.
            "label": "test",
            "type": "shell",
            "command": "make -C build-debug botanik_tests && (cd build-debug && ctest --output-on-failure)",
            "dependsOn": "cmake-configure-sim",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            // The full pre-push gate: warning-clean build + clang-tidy + unit
            // tests (the `check` custom target defined in tests/CMakeLists.txt).
            "label": "check",
            "type": "shell",
            "command": "make -C build-debug check",
            "dependsOn": "cmake-configure-sim",
            "group": "test",
            "problemMatcher": "$gcc"
        },
        {
            // clang-tidy only (faster than the full `check` gate) across src/, via the
            // cmake custom target — same binary and .clang-tidy config as CI. A task,
            // not a launch config: launch configs start a debugger; this runs a linter
            // and routes its findings to the Problems panel via the matcher below.
            "label": "clang-tidy",
            "type": "shell",
            "command": "make -C build-debug clang-tidy",
            "dependsOn": "cmake-configure-sim",
            "problemMatcher": {
                "owner": "clang-tidy",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            // OPTA cross-compile sanity build: size-optimized + LTO static library
            // (cmake/opta-toolchain.cmake supplies the arm-none-eabi toolchain).
            "label": "cmake-configure-opta",
            "type": "shell",
            "command": "cmake -B build-opta -DBOTANIK_TARGET=OPTA",
            "problemMatcher": []
        },
        {
            // Compile the library for OPTA (no final binary — sanity/size check).
            "label": "build-opta",
            "type": "shell",
            "command": "make -C build-opta",
            "dependsOn": "cmake-configure-opta",
            "problemMatcher": "$gcc"
        }
    ]
}

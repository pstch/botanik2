{
    "version": "0.2.0",
    "configurations": [
        {
            // Default: build + run the simulator under gdb in an external xterm
            // window. The sim requires a real pty (it puts stdin into raw mode and
            // bails unless isatty() is true), and a dedicated window keeps its ANSI
            // UI from fighting VS Code's panel chrome. On Linux "externalTerminal"
            // spawns the program in whatever terminal.external.linuxExec points to;
            // we pin that to xterm in settings.json. Full live debugging works:
            // breakpoints, stepping, watches, etc.
            "name": "Debug simulator (xterm)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/xterm",
            "args": ["-e", "${workspaceFolder}/build-debug/botanik_sim"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            // "console": "externalTerminal",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build-sim",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Follow the child process across fork()",
                    "text": "set follow-fork-mode child",
                    "ignoreFailures": false
                }
            ]
        },
    ]
}

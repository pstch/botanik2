{
    // Both configurations read the compile database CMake writes
    // (CMAKE_EXPORT_COMPILE_COMMANDS is ON), so IntelliSense sees the flags the
    // build used rather than a hand-copied list of Mbed include paths and
    // defines. Configure the matching tree once and this stays right:
    //   cmake -B build       -DBOTANIK_TARGET=SIMULATOR
    //   cmake -B build-opta  -DBOTANIK_TARGET=OPTA
    "version": 4,
    "configurations": [
        {
            "name": "SIMULATOR",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "compilerPath": "/usr/bin/g++",
            "intelliSenseMode": "linux-gcc-x64",
            "cppStandard": "c++11",
            "cStandard": "c11"
        },
        {
            "name": "OPTA",
            "compileCommands": "${workspaceFolder}/build-opta/compile_commands.json",
            "compilerPath": "/usr/bin/arm-none-eabi-g++",
            "intelliSenseMode": "linux-gcc-arm",
            "cppStandard": "c++11",
            "cStandard": "c11"
        }
    ]
}

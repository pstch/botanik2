{
    // Both configurations read the compile database CMake writes
    // (CMAKE_EXPORT_COMPILE_COMMANDS is ON), so IntelliSense sees exactly the
    // flags the build used. The OPTA entry used to hand-copy the Mbed core's 35
    // include paths and 86 defines with the core version hardcoded - a second
    // copy of what the build already auto-discovers, guaranteed to drift on the
    // next core upgrade. Configure the matching tree once and this stays right:
    //   cmake -B build-debug -DBOTANIK_TARGET=SIMULATOR
    //   cmake -B build-opta  -DBOTANIK_TARGET=OPTA
    "version": 4,
    "configurations": [
        {
            "name": "SIMULATOR",
            "compileCommands": "${workspaceFolder}/build-debug/compile_commands.json",
            "compilerPath": "/usr/bin/g++",
            "intelliSenseMode": "linux-gcc-x64",
            "cppStandard": "c++11",
            "cStandard": "c11"
        },
        {
            "name": "OPTA",
            "compileCommands": "${workspaceFolder}/build-opta/compile_commands.json",
            "compilerPath": "/usr/bin/arm-none-eabi-g++",
            "intelliSenseMode": "linux-gcc-arm",
            "cppStandard": "c++11",
            "cStandard": "c11"
        }
    ]
}
